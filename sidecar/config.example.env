CODEX_BIN=/usr/local/bin/codex
CODEX_WP_STORAGE_ROOT=/var/lib/codex-wp
CODEX_WP_HOST=127.0.0.1
CODEX_WP_PORT=4317
CODEX_WP_RUNTIME_BASE_URL=http://127.0.0.1:4317
CODEX_WP_BEARER_TOKEN=replace-me
CODEX_RUNTIME_REQUEST_TIMEOUT=60
CODEX_RUNTIME_TURN_TIMEOUT=300
CODEX_RUNTIME_LOGIN_TIMEOUT=1800

# Private CA trust anchors (optional; forwarded to Codex child processes).
# Proxies are not forwarded; the sidecar host must reach chatgpt.com directly.
# SSL_CERT_FILE=/etc/ssl/certs/custom-ca.pem
# SSL_CERT_DIR=/etc/ssl/certs
# CODEX_CA_CERTIFICATE=/etc/ssl/certs/custom-ca.pem
