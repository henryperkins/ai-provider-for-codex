parameters:
	ignoreErrors:
		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: plugin.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: plugin.php

		# Version_compare against AiClient::VERSION is forward-compat for SDK upgrades.
		# Description support added in php-ai-client 1.2.0, logoPath in 1.3.0.
		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 2
			path: src/Provider/CodexProvider.php
